{
  "name": "angular-puck-composer",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "puck:generate": "node scripts/puck/generate.mjs",
    "puck:check": "node scripts/puck/generate.mjs --check",
    "puck:verify": "node scripts/puck/verify.mjs",
    "puck:smoke": "node scripts/puck/smoke.mjs",
    "storybook": "ng run ui:storybook",
    "build:storybook": "ng run ui:build-storybook",
    "build:elements": "ng build elements",
    "build:composer": "pnpm --filter @apc/composer build",
    "build": "pnpm build:elements && pnpm build:composer && pnpm build:storybook",
    "dev": "pnpm run \"/^dev:/\"",
    "dev:elements": "ng build elements --watch --configuration development",
    "dev:composer": "pnpm --filter @apc/composer dev",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/elements": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.2",
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/angular": "^10.6.2",
    "@types/node": "^24.19.2",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "playwright": "^1.64.1",
    "prettier": "^3.8.1",
    "storybook": "^10.6.2",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
