{
  "name": "angular-puck-composer",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "puck:generate": "node scripts/puck/generate.mjs",
    "puck:check": "node scripts/puck/generate.mjs --check",
    "puck:verify": "node scripts/puck/verify.mjs",
    "puck:smoke": "node scripts/puck/smoke.mjs",
    "storybook": "ng run ui:storybook",
    "build:storybook": "ng run ui:build-storybook",
    "build:elements": "ng build elements",
    "build:composer": "npm run build -w @apc/composer",
    "build": "npm run build:elements && npm run build:composer && npm run build:storybook",
    "dev": "node scripts/dev.mjs",
    "dev:elements": "ng build elements --watch --configuration development",
    "dev:composer": "npm run dev -w @apc/composer",
    "test": "ng test"
  },
  "private": true,
  "workspaces": [
    "composer",
    "server"
  ],
  "engines": {
    "node": "^22.15.0 || >=24.0.0"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/elements": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.0",
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/platform-browser-dynamic": "^21.2.0",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/angular": "^10.6.2",
    "@types/node": "^22.15.0",
    "jsdom": "^29.0.0",
    "ng-packagr": "^21.2.0",
    "playwright": "^1.64.1",
    "prettier": "^3.8.1",
    "storybook": "^10.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.0"
  }
}
